# Copy to .env and adjust. NEVER commit your real .env.
# No third-party API keys are required for the default local setup (Binance public
# data via CCXT). Keys below are optional and only needed for private/extended data.

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=kronos
POSTGRES_PASSWORD=kronos
POSTGRES_DB=kronos_terminal
POSTGRES_PORT=5432

# --- Backend (KAT_ prefix) ---
KAT_ENV=local
KAT_LOG_LEVEL=INFO
KAT_LOG_JSON=false

# When running the backend OUTSIDE docker, point this at your local Postgres:
KAT_DATABASE_URL=postgresql+psycopg2://kronos:kronos@localhost:5432/kronos_terminal

# Directories (defaults are fine locally; docker-compose overrides them)
# KAT_CONFIG_DIR=./configs
# KAT_DATA_DIR=./data
# KAT_MODELS_DIR=./models

# Safety: live trading is OFF and there is no shipped live adapter.
KAT_ENABLE_LIVE_TRADING=false
KAT_ENABLE_SCHEDULER=true

# Forecast mode: auto | true (force mock) | false (require real model)
KAT_MOCK_MODE=auto

# CORS origin for the dashboard
KAT_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- OPTIONAL exchange API keys (not needed for public candle data) ---
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
